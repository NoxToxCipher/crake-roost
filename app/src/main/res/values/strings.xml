<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Crake Roost</string>
    <string name="tagline">Run a Tox relay on this device</string>

    <string name="start">Start relay</string>
    <string name="stop">Stop relay</string>

    <!-- Status carries a shape glyph and a word, so colour is never the only
         signal. "Running" is deliberately not "Healthy": we have not checked
         that anyone can reach it. -->
    <string name="status_stopped">○  Stopped</string>
    <string name="status_starting">◐  Starting</string>
    <string name="status_running">●  Running. Reachability not checked</string>
    <string name="status_running_idle">●  Running. No one has reached it yet</string>
    <string name="status_reachable">●  Reachable. A peer has connected in</string>
    <string name="status_failed">▲  Failed to start</string>

    <string name="key_label">This node\'s key</string>
    <string name="key_none">Not running</string>

    <string name="start_on_boot">Start when the phone boots</string>
    <string name="battery">Keep it alive: exempt from battery optimisation</string>

    <string name="channel_name">Relay node</string>
    <string name="channel_desc">Shows that the relay is running</string>

    <!-- Broadcast so others can see this is a Crake node. -->
    <string name="motd">Crake Roost</string>

    <string name="reach_note">Running is not the same as reachable. A relay behind a home NAT relays nothing until its port is forwarded, and it cannot be reached at all behind carrier NAT. The status above stays amber until a peer actually connects in, then turns green. That green is earned, not assumed.</string>
</resources>
